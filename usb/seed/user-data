#cloud-config
# ============================================================
# Second Wind — autoinstall seed for Ubuntu Desktop 24.04 LTS.
# Lives on the USB stick in a small volume labeled CIDATA
# (cloud-init NoCloud); the official Ubuntu ISO is untouched.
#
# ⚠ THIS SEED WIPES THE ENTIRE TARGET DISK (that is its job).
# ============================================================
autoinstall:
  version: 1

  # The person answers only the personal screens in Ubuntu's own friendly
  # installer (language, keyboard, WiFi, name/password). Everything else
  # is automated.
  interactive-sections:
    - locale
    - keyboard
    - network
    - identity

  # Defaults, in case any section above runs non-interactively on some
  # installer build (the interactive screens override them):
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: second-wind
    realname: Second Wind
    username: wind
    # placeholder password "secondwind" (SHA-512 crypt); the interactive
    # identity screen replaces it
    password: "@PASSWORD_HASH@"

  # P0 safety (council blocker): this stick must be unable to wipe the wrong
  # machine or the wrong disk.
  #   1. early-commands abort on non-Apple hardware (DMI vendor check) BEFORE
  #      any disk is touched — a PC that boots this stick gets a clear
  #      bilingual message, not a wipe. QEMU is allowed for the VM test bench.
  #   2. the storage match only ever selects Apple-branded internal disks
  #      (all 2013–2017 Macs ship "APPLE SSD/HDD …" models) — an external
  #      USB drive can never be picked. QEMU HARDDISK again for the VM.
  # Known, accepted limit: a Mac whose internal disk was replaced by a
  # third-party SSD stops with an error instead of installing — those users
  # take the classic install.sh path. Safe beats convenient here.
  early-commands:
    - |
      vendor="$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || echo unknown)"
      case "$vendor" in
        Apple*|QEMU*) echo "Second Wind: hardware check passed ($vendor)" ;;
        *)
          echo "Second Wind: this USB stick only installs on Mac computers (this is: $vendor)." >&2
          echo "Second Wind: este pendrive solo instala en computadores Mac (esto es: $vendor)." >&2
          exit 1
          ;;
      esac
    # Macs with Apple's T2 chip (2018-2020) need a patched kernel and WiFi
    # files that only exist inside macOS — this stick cannot run them yet.
    # Stop BEFORE any disk is touched, with a clear message (their Mac stays
    # exactly as it was). Detected by the T2 bridge's PCI IDs, plus the model
    # identifier as a second signal.
    - |
      t2=""
      for dev in /sys/bus/pci/devices/*; do
        case "$(cat "$dev/vendor" 2>/dev/null):$(cat "$dev/device" 2>/dev/null)" in
          0x106b:0x1801|0x106b:0x1802) t2=yes ;;
        esac
      done
      model="$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo unknown)"
      case "$model" in
        MacBookPro15,*|MacBookPro16,*|MacBookAir8,*|MacBookAir9,*|Macmini8,*|iMac20,*|iMacPro1,*|MacPro7,*) t2=yes ;;
      esac
      if [ -n "$t2" ]; then
        echo "Second Wind: this Mac ($model) has Apple's T2 chip, which Second Wind does not support yet. Nothing was erased; you can turn it off and remove the stick." >&2
        echo "Second Wind: este Mac ($model) tiene el chip T2 de Apple, que Second Wind todavía no soporta. No se borró nada; puedes apagarlo y sacar el pendrive." >&2
        exit 1
      fi
    # The storage match below only accepts Apple-branded internal disks. A Mac
    # whose SSD was replaced (very common on 128 GB Airs) used to die later
    # with a raw "no disk matched" error. Say it plainly instead, before
    # anything is touched. (USB and removable disks, like this stick, never count.)
    - |
      apple=""; other=""
      for b in /sys/block/sd* /sys/block/nvme*n*; do
        [ -e "$b/device" ] || continue
        [ "$(cat "$b/removable" 2>/dev/null)" = 1 ] && continue
        case "$(readlink -f "$b")" in */usb*) continue ;; esac
        m="$(cat "$b/device/model" 2>/dev/null | sed 's/ *$//')"
        case "$m" in APPLE*|QEMU*) apple=yes ;; *) other="${other:+$other, }${m:-unknown}" ;; esac
      done
      if [ -z "$apple" ]; then
        echo "Second Wind: this Mac's internal disk is not an original Apple disk (${other:-none found}). Second Wind cannot install on it automatically yet. Nothing was erased; you can turn it off and remove the stick." >&2
        echo "Second Wind: el disco interno de este Mac no es el original de Apple (${other:-no se encontró}). Second Wind todavía no puede instalarse solo en él. No se borró nada; puedes apagarlo y sacar el pendrive." >&2
        exit 1
      fi

  # Wipe the whole disk with the standard direct layout — but only a disk
  # that matches the guard above.
  storage:
    layout:
      name: direct
      match:
        - model: "APPLE*"
        - model: "QEMU*"

  # Third-party drivers (Broadcom WiFi on Intel Macs) and media codecs.
  # OFFLINE FIX (22-09, real Air 2013): these fetch from the network DURING the
  # install. On a Broadcom Mac there is NO internet at install time (its WiFi
  # needs the very driver these would fetch — chicken-and-egg), so the installer
  # aborted deterministically. We defer BOTH to firstboot, which waits for
  # connectivity and then runs Second Wind's install.sh. The Broadcom WiFi
  # driver no longer waits for that: a late-command below installs it OFFLINE
  # (prebuilt, usb/drivers/), so WiFi works on the very first boot.
  drivers:
    install: false
  codecs:
    install: false

  # geoip has its own timeout and falls back cleanly offline (kept). `updates`
  # is dropped: fetching updates mid-install needs the network and must never be
  # able to abort an offline install. Security updates happen post-firstboot.
  timezone: geoip

  late-commands:
    # Ubuntu Desktop's default install ships WITHOUT curl and git, which
    # Second Wind needs (bug caught in the first full VM rehearsal: the
    # firstboot net-check failed forever on a machine with perfect internet).
    # Best-effort only: `|| true` so an OFFLINE install (Broadcom Mac, no net
    # yet) never aborts here. When there is no network these stay uninstalled,
    # and firstboot's 00-preflight installs them once online (phone tether).
    - curtin in-target -- apt-get install -y curl git || true
    # WiFi WITHOUT internet on Broadcom Macs (23-09, real Air 2013). Their WiFi
    # chip needs Broadcom's `wl` driver, which normally has to be DOWNLOADED —
    # impossible offline (and the copy on the 24.04.4 ISO does not even build
    # on the ISO's own 6.17 kernel, LP #2120508). So the payload carries `wl`
    # prebuilt for the exact kernel this ISO installs (usb/drivers/, pinned by
    # sha256 in versions.lock). Here we drop it in, blacklist the conflicting
    # free drivers and rebuild the initramfs: WiFi works on the very first
    # boot. Never fatal: if anything is off, the install still completes and
    # firstboot falls back to the wired/tethered path with a clear message.
    # The marker file tells sw-ga-kernel (below) to keep this kernel and tells
    # module 15 to hand wl over to DKMS once online (future kernel updates).
    - |
      set -x
      LOG=/target/var/log/second-wind-wifi.log
      mkdir -p /target/var/log /target/var/lib/second-wind
      exec >>"$LOG" 2>&1
      echo "== Second Wind offline WiFi $(date -u +%FT%TZ)"
      W=/tmp/sw-wl; rm -rf "$W"; mkdir -p "$W/seed"
      mount -o ro /dev/disk/by-label/CIDATA "$W/seed" \
        || mount -o ro /dev/disk/by-label/cidata "$W/seed" || { echo "no CIDATA"; exit 0; }
      tar -xzf "$W/seed/second-wind.tar.gz" -C "$W" second-wind/usb/drivers second-wind/versions.lock || true
      umount "$W/seed" || true
      D="$W/second-wind/usb/drivers"
      [ -f "$W/second-wind/versions.lock" ] || { echo "payload has no drivers"; exit 0; }
      WL_KERNEL=$(sed -n 's/^WL_KERNEL=//p' "$W/second-wind/versions.lock")
      WL_KO_SHA256=$(sed -n 's/^WL_KO_SHA256=//p' "$W/second-wind/versions.lock" | cut -d' ' -f1)
      HIT=""
      for dev in /sys/bus/pci/devices/*; do
        id="$(sed 's/^0x//' "$dev/vendor"):$(sed 's/^0x//' "$dev/device")"
        grep -qix "$id" "$D/wl-pci-ids" 2>/dev/null && HIT="$id"
      done
      [ -n "$HIT" ] || { echo "no wl-supported Broadcom chip: nothing to do"; exit 0; }
      echo "Broadcom chip $HIT; target kernels: $(ls /target/lib/modules)"
      KO="$D/wl-$WL_KERNEL.ko.xz"
      if [ ! -d "/target/lib/modules/$WL_KERNEL" ]; then
        echo "FAIL: target kernel is not $WL_KERNEL (prebuilt wl does not match)"; exit 0
      fi
      if ! echo "$WL_KO_SHA256  $KO" | sha256sum -c -; then
        echo "FAIL: wl module checksum mismatch"; exit 0
      fi
      mkdir -p "/target/lib/modules/$WL_KERNEL/extra/second-wind"
      xz -dc "$KO" > "/target/lib/modules/$WL_KERNEL/extra/second-wind/wl.ko"
      install -D -m 0644 "$D/blacklist-wl-conflicts.conf" /target/etc/modprobe.d/second-wind-wl.conf
      install -D -m 0644 "$D/LICENSE-broadcom-wl.txt" /target/usr/share/doc/second-wind-wl/LICENSE
      curtin in-target -- depmod -a "$WL_KERNEL"
      if curtin in-target -- modinfo -k "$WL_KERNEL" -n wl | grep -q /extra/second-wind/wl.ko; then
        echo "$HIT $WL_KERNEL" > /target/var/lib/second-wind/wl-preinstalled
        curtin in-target -- update-initramfs -u -k "$WL_KERNEL" || echo "WARN: initramfs not refreshed"
        echo "OK: wl preinstalled for $WL_KERNEL"
        # Keep this kernel until the driver is handed to DKMS (module 15,
        # first online run — normally the first boot, since WiFi now works).
        # Bounded: module 15 lifts the hold right after the handover.
        curtin in-target -- apt-mark hold linux-generic-hwe-24.04 linux-image-generic-hwe-24.04 linux-headers-generic-hwe-24.04 \
          && echo "kernel updates held until DKMS handover" || echo "WARN: could not hold kernel"
      else
        echo "FAIL: depmod does not resolve wl"
        rm -f "/target/lib/modules/$WL_KERNEL/extra/second-wind/wl.ko" /target/etc/modprobe.d/second-wind-wl.conf
        curtin in-target -- depmod -a "$WL_KERNEL" || true
      fi
      rm -rf "$W"
      exit 0
    # Council blocker "the installed product breaks itself": the HWE kernel
    # rolls to new majors (6.8→6.14→…) and each roll can break the Broadcom
    # wl WiFi driver. New installs pin to the GA 6.8 series instead —
    # LTS-first, same philosophy as versions.lock. (The live ISO's kernel is
    # running, not the target's, so purging HWE images in-target is safe.)
    # (H1, caught by the 31-08 VM certification: purging the metas is NOT
    # enough — apt's kernel protection shields the newest HWE *image* from
    # autoremove, and GRUB then boots a frozen, never-patched 7.x. After
    # installing GA we therefore purge every versioned kernel package outside
    # the 6.8 series explicitly, guarded on the GA image actually being
    # present — offline installs still just stay on HWE quietly.)
    - |
      cat > /target/usr/local/sbin/sw-ga-kernel.sh <<'EOS'
      #!/bin/bash
      set -x
      export DEBIAN_FRONTEND=noninteractive
      # Broadcom Macs with the offline wl driver keep the ISO kernel it was
      # built for (switching kernels here would leave them without WiFi).
      [ -f /var/lib/second-wind/wl-preinstalled ] && exit 0
      apt-get install -y linux-generic || exit 0
      METAS=$(dpkg-query -W -f '${Package} ' 'linux-*hwe*' 2>/dev/null || true)
      [ -n "$METAS" ] && apt-get purge -y $METAS || true
      if dpkg-query -W 'linux-image-6.8.*-generic' >/dev/null 2>&1; then
        DROP=$(dpkg-query -W -f '${Package}\n' 'linux-image-[0-9]*' 'linux-headers-[0-9]*' 'linux-modules-*-generic' 2>/dev/null | grep -v -- '-6\.8\.' || true)
        [ -n "$DROP" ] && apt-get purge -y $DROP || true
      fi
      apt-get autoremove --purge -y || true
      update-grub || true
      exit 0
      EOS
      chmod +x /target/usr/local/sbin/sw-ga-kernel.sh
      curtin in-target -- /usr/local/sbin/sw-ga-kernel.sh || true
      rm -f /target/usr/local/sbin/sw-ga-kernel.sh
    # Copy Second Wind from the seed volume into the installed system and
    # arm the first-login bootstrap for every created user.
    - |
      set -x
      mkdir -p /mnt/swseed
      mount -o ro /dev/disk/by-label/CIDATA /mnt/swseed \
        || mount -o ro /dev/disk/by-label/cidata /mnt/swseed || true
      if [ -f /mnt/swseed/second-wind.tar.gz ]; then
        mkdir -p /target/usr/local/share
        tar -xzf /mnt/swseed/second-wind.tar.gz -C /target/usr/local/share
        install -D -m 0755 /mnt/swseed/firstboot/second-wind-firstboot.sh \
          /target/usr/local/share/second-wind/firstboot/second-wind-firstboot.sh
        install -D -m 0644 /mnt/swseed/firstboot/second-wind-firstboot.desktop \
          /target/etc/skel/.config/autostart/second-wind-firstboot.desktop
        for H in /target/home/*; do
          [ -d "$H" ] || continue
          U="$(basename "$H")"
          install -D -m 0644 /mnt/swseed/firstboot/second-wind-firstboot.desktop \
            "$H/.config/autostart/second-wind-firstboot.desktop"
          chroot /target chown -R "$U:$U" "/home/$U/.config" || true
        done
      fi
      umount /mnt/swseed || true
