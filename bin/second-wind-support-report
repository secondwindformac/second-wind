#!/usr/bin/env python3
"""second-wind-support-report — "Copy report for support" (health plan, phase 1).

  second-wind-support-report          window: shows the WHOLE report, then copies
  second-wind-support-report --text   print it (exit 3 if the privacy guard fails)

Nothing is sent anywhere: the person reads the text and chooses where to paste
it. What goes in and what can never go in: lib/support_report.py.
"""
import os
import sys

SW_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(SW_ROOT, "lib"))
import support_report  # noqa: E402

ES = os.environ.get("LANG", "en").startswith("es")


def d(es, en):
    return es if ES else en


T = {
    "title": d("Informe para soporte", "Support report"),
    "intro": d("Esto es TODO lo que contiene el informe. No se envía a ningún lado: "
               "al copiarlo, tú decides dónde pegarlo (un correo o el chat de soporte).",
               "This is EVERYTHING in the report. It is not sent anywhere: once copied, "
               "you choose where to paste it (an e-mail or the support chat)."),
    "privacy": d("Second Wind no envía datos tuyos: solo consulta si hay mejoras, baja los "
                 "íconos de la tienda y activa tu licencia cuando tú lo pides.",
                 "Second Wind does not send your data: it only checks for improvements, "
                 "downloads the store's icons and activates your license when you ask it to."),
    "copy": d("Copiar informe", "Copy report"),
    "copied": d("Copiado ✓", "Copied ✓"),
    "paste": d("Listo. Pégalo con ⌘V en tu correo o en el chat de soporte.",
               "Done. Paste it with ⌘V into your e-mail or the support chat."),
    "close": d("Cerrar", "Close"),
    "unsafe": d("No se pudo preparar el informe de forma segura, así que no se muestra ni se "
                "copia nada. Cuéntale a soporte que viste este aviso.",
                "The report could not be prepared safely, so nothing is shown or copied. "
                "Tell support you saw this message."),
}


def main_text():
    text, problems = support_report.build(sw_root=SW_ROOT)
    if problems:
        print(T["unsafe"], file=sys.stderr)
        return 3
    sys.stdout.write(text)
    return 0


def main_gui():
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gdk, Gtk

    text, problems = support_report.build(sw_root=SW_ROOT)

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id="app.secondwind.SupportReport")
            self.clip = None

        def do_activate(self):
            win = Adw.ApplicationWindow(application=self, title=T["title"],
                                        default_width=620, default_height=560)
            view = Adw.ToolbarView()
            view.add_top_bar(Adw.HeaderBar())
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                          margin_top=6, margin_bottom=18, margin_start=18, margin_end=18)
            if problems:
                box.append(Gtk.Label(label=T["unsafe"], wrap=True, xalign=0))
                close = Gtk.Button(label=T["close"], halign=Gtk.Align.END)
                close.connect("clicked", lambda *_: win.close())
                box.append(close)
            else:
                box.append(Gtk.Label(label=T["intro"], wrap=True, xalign=0))
                tv = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                  wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=10,
                                  bottom_margin=10, left_margin=12, right_margin=12)
                tv.get_buffer().set_text(text)
                frame = Gtk.Frame(child=Gtk.ScrolledWindow(child=tv, vexpand=True))
                box.append(frame)
                box.append(Gtk.Label(label=T["privacy"], wrap=True, xalign=0,
                                     css_classes=["dim-label", "caption"]))
                self.done = Gtk.Label(label="", wrap=True, xalign=0)
                box.append(self.done)
                row = Gtk.Box(spacing=8, halign=Gtk.Align.END)
                close = Gtk.Button(label=T["close"])
                close.connect("clicked", lambda *_: win.close())
                copy = Gtk.Button(label=T["copy"], css_classes=["suggested-action"])
                copy.connect("clicked", self.on_copy, text)
                row.append(close)
                row.append(copy)
                box.append(row)
            view.set_content(box)
            win.set_content(view)
            win.present()

        def on_copy(self, button, text):
            self.clip = Gdk.Display.get_default().get_clipboard()
            self.clip.set(text)
            button.set_label(T["copied"])
            self.done.set_label(T["paste"])
            # Wayland drops the clipboard when its owner exits: keep this
            # process (windowless) until something else is copied.
            if not getattr(self, "_held", False):
                self._held = True
                self.hold()
                self.clip.connect("changed", self.on_clip_changed)

        def on_clip_changed(self, clip):
            if not clip.is_local() and getattr(self, "_held", False):
                self._held = False
                self.release()

    return App().run([sys.argv[0]])


if __name__ == "__main__":
    if "--text" in sys.argv:
        sys.exit(main_text())
    sys.exit(main_gui())
