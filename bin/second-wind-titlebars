#!/usr/bin/env python3
"""second-wind-titlebars — Mac window buttons (red/yellow/green) for apps that
draw their own title bar but have a "use the system title bar" option.

Runs at every login (autostart, from 55-browsers) and right after Second Wind
Apps installs something, so apps installed LATER get it too. (Real case, Air,
24-Sep-2026: Chrome was installed after 55-browsers ran — "Chrome is not
installed" in the log — and kept its own grey buttons.)

Rules: each settings file is adjusted ONCE. If the person later changes it
back (picks a Chrome color theme, turns the custom title bar on again), that
is their choice and later logins leave it alone; the record below is what
marks a file as already adjusted. An app is only touched while it is CLOSED (they rewrite their settings
on exit); the original value is recorded once in
~/.local/state/second-wind/titlebars-before.json so `--undo` (uninstall.sh)
puts it back exactly. Apps with no such option (Electron apps like Spotify or
Claude) cannot be changed from outside and are left alone.
"""
import glob
import json
import os
import subprocess
import sys

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".local/state/second-wind")
RECORD = os.path.join(STATE, "titlebars-before.json")
ABSENT = "__absent__"

# Chromium family: browser.custom_chrome_frame = false asks for the system
# title bar. On Wayland recent Chrome (154 on the Air) ignores it and always
# draws its own grey ✕ – □; switching it to GTK mode does not stick either
# (a signed-in Chrome re-applies the account's synced color theme). What
# works: run it through XWayland (--ozone-platform=x11), where GNOME draws
# the title bar with the theme's red/yellow/green buttons and the person's
# own color theme stays. So the pref + that flag on every Chromium launcher
# (dock/app grid entries, the default-browser entry used by links, and
# Chrome web apps such as WhatsApp).
CHROME_PREFS = {
    "browser.custom_chrome_frame": False,
}
X11_FLAG = "--ozone-platform=x11"
CHROMIUM_DESKTOPS = ["google-chrome.desktop", "com.google.Chrome.desktop",
                     "chromium.desktop", "chromium-browser.desktop",
                     "chromium_chromium.desktop", "brave-browser.desktop",
                     "microsoft-edge.desktop"]
CHROMIUM_BINS = ("google-chrome", "chrome", "chromium", "chromium-browser",
                 "brave-browser", "brave", "microsoft-edge", "msedge")
CHROMIUMS = [
    # (config dir, process names, installed-if any of these exists)
    (".config/google-chrome", ["chrome"], ["/usr/bin/google-chrome", "/opt/google/chrome/chrome"]),
    (".config/chromium", ["chromium", "chromium-browse"], ["/usr/bin/chromium", "/usr/bin/chromium-browser"]),
    ("snap/chromium/common/chromium", ["chromium", "chrome"], ["/snap/bin/chromium"]),
    (".config/BraveSoftware/Brave-Browser", ["brave"], ["/usr/bin/brave-browser", "/opt/brave.com"]),
    (".config/microsoft-edge", ["msedge"], ["/usr/bin/microsoft-edge", "/opt/microsoft/msedge"]),
]
ONLYOFFICE = [
    # QSettings file; "Use system window title bar" in its settings writes
    # titlebar=system (default: custom).
    (".config/onlyoffice/DesktopEditors.conf", ["/usr/bin/onlyoffice-desktopeditors", "/opt/onlyoffice"]),
    ("snap/onlyoffice-desktopeditors/current/.config/onlyoffice/DesktopEditors.conf",
     ["/snap/onlyoffice-desktopeditors/current"]),
]
VSCODES = [
    (".config/Code/User/settings.json", ["code"], ["/usr/bin/code", "/snap/bin/code"]),
    (".config/VSCodium/User/settings.json", ["codium"], ["/usr/bin/codium", "/snap/bin/codium"]),
]


def running(names):
    return any(subprocess.run(["pgrep", "-x", n], capture_output=True).returncode == 0
               for n in names)


def installed(paths):
    return any(os.path.exists(p) for p in paths)


def load_record():
    try:
        with open(RECORD) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_record(rec):
    os.makedirs(STATE, exist_ok=True)
    tmp = RECORD + ".tmp"
    with open(tmp, "w") as f:
        json.dump(rec, f, indent=1)
    os.replace(tmp, RECORD)


def write_json(path, data):
    tmp = path + ".secondwind.tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def chromium_profiles(base):
    found = sorted(glob.glob(os.path.join(base, "Default", "Preferences"))
                   + glob.glob(os.path.join(base, "Profile *", "Preferences")))
    return found


def get_key(d, dotted):
    for k in dotted.split(".")[:-1]:
        d = d.get(k, {}) if isinstance(d, dict) else {}
    return d.get(dotted.split(".")[-1], ABSENT) if isinstance(d, dict) else ABSENT


def set_key(d, dotted, value):
    keys = dotted.split(".")
    for k in keys[:-1]:
        d = d.setdefault(k, {})
    if value == ABSENT:
        d.pop(keys[-1], None)
    else:
        d[keys[-1]] = value


def applied_before(old):
    # dict = values recorded by this version; ABSENT:file = we created the file.
    # A plain string is the record of the first version (frame pref only).
    if old == ABSENT + ":file":
        return True
    return isinstance(old, dict) and all(k in old for k in CHROME_PREFS)


def do_chromium(rec, log):
    for rel, procs, bins in CHROMIUMS:
        if not installed(bins):
            continue
        base = os.path.join(HOME, rel)
        if running(procs):
            log(f"{rel}: open, will retry at next login")
            continue
        prefs = chromium_profiles(base)
        if not prefs:
            # Installed but never opened: seed the profile so the very first
            # window already has the Mac buttons (Chrome merges this file).
            p = os.path.join(base, "Default", "Preferences")
            os.makedirs(os.path.dirname(p), exist_ok=True)
            rec.setdefault(p, ABSENT + ":file")
            d = {}
            for k, v in CHROME_PREFS.items():
                set_key(d, k, v)
            write_json(p, d)
            log(f"{p}: seeded")
            continue
        for p in prefs:
            if applied_before(rec.get(p)):
                continue   # adjusted once already: never fight a later choice
            try:
                with open(p) as f:
                    d = json.load(f)
            except (OSError, ValueError):
                continue
            changed = {k: get_key(d, k) for k, v in CHROME_PREFS.items() if get_key(d, k) != v}
            if not changed:
                continue
            old = rec.get(p)
            if isinstance(old, str) and old != ABSENT + ":file":   # pre-GTK-mode record
                old = {"browser.custom_chrome_frame": old}
            old = dict(old or {})
            for k in CHROME_PREFS:   # record every key, so applied_before() holds
                old.setdefault(k, changed.get(k, get_key(d, k)))
            rec[p] = old
            for k, v in CHROME_PREFS.items():
                set_key(d, k, v)
            write_json(p, d)
            log(f"{p}: " + ", ".join(f"{k} {b} -> {CHROME_PREFS[k]}" for k, b in changed.items()))


def flag_exec(line):
    """Exec=/usr/bin/google-chrome-stable %U → add the X11 flag after the binary."""
    cmd = line[len("Exec="):].split()
    if X11_FLAG in cmd:
        return line
    for i, word in enumerate(cmd):
        if os.path.basename(word).replace("-stable", "") in CHROMIUM_BINS:
            return "Exec=" + " ".join(cmd[:i + 1] + [X11_FLAG] + cmd[i + 1:])
    return line


def do_chromium_launchers(rec, log):
    # Unlike the settings files, launchers are checked at EVERY login: they are
    # not a personal choice, and 55-browsers regenerates google-chrome.desktop
    # (VA-API flags) from the system file, which drops the X11 flag.
    apps = os.path.join(HOME, ".local/share/applications")
    targets = []
    for name in CHROMIUM_DESKTOPS:
        local, system = os.path.join(apps, name), None
        for d in ("/usr/share/applications", "/var/lib/snapd/desktop/applications"):
            if os.path.exists(os.path.join(d, name)):
                system = os.path.join(d, name)
        if os.path.exists(local) or system:
            targets.append((local, system))
    # Chrome web apps made by Second Wind Apps (secondwind-*.desktop, --app=...)
    for local in glob.glob(os.path.join(apps, "secondwind-*.desktop")):
        targets.append((local, None))
    for local, system in targets:
        src = local if os.path.exists(local) else system
        try:
            with open(src) as f:
                lines = f.read().splitlines()
        except OSError:
            continue
        new = [flag_exec(l) if l.startswith("Exec=") else l for l in lines]
        if new == lines:
            continue
        rec.setdefault(local, "__flag__" if os.path.exists(local) else ABSENT + ":file")
        os.makedirs(apps, exist_ok=True)
        with open(local + ".secondwind.tmp", "w") as f:
            f.write("\n".join(new) + "\n")
        os.replace(local + ".secondwind.tmp", local)
        log(f"{local}: {X11_FLAG}")


def do_onlyoffice(rec, log):
    for rel, bins in ONLYOFFICE:
        if not installed(bins):
            continue
        if running(["DesktopEditors"]):
            log("onlyoffice: open, will retry at next login")
            continue
        p = os.path.join(HOME, rel)
        if p in rec:
            continue   # adjusted once already: respect a later change
        lines = []
        if os.path.exists(p):
            with open(p) as f:
                lines = f.read().splitlines()
        cur = next((l.split("=", 1)[1] for l in lines if l.startswith("titlebar=")), ABSENT)
        if cur == "system":
            continue
        rec.setdefault(p, (ABSENT + ":file") if not os.path.exists(p) else cur)
        lines = [l for l in lines if not l.startswith("titlebar=")]
        if "[General]" not in lines:
            lines = ["[General]"] + lines
        lines.insert(lines.index("[General]") + 1, "titlebar=system")
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p + ".secondwind.tmp", "w") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(p + ".secondwind.tmp", p)
        log(f"{p}: titlebar {cur} -> system")


def do_vscode(rec, log):
    for rel, procs, bins in VSCODES:
        if not installed(bins) or running(procs):
            continue
        p = os.path.join(HOME, rel)
        if p in rec:
            continue   # adjusted once already: respect a later change
        try:
            with open(p) as f:
                d = json.load(f)   # a settings.json with comments is left alone
        except FileNotFoundError:
            d = None
        except (OSError, ValueError):
            continue
        cur = ABSENT if d is None else d.get("window.titleBarStyle", ABSENT)
        if cur == "native":
            continue
        rec.setdefault(p, (ABSENT + ":file") if d is None else cur)
        d = d or {}
        d["window.titleBarStyle"] = "native"
        os.makedirs(os.path.dirname(p), exist_ok=True)
        write_json(p, d)
        log(f"{p}: window.titleBarStyle {cur} -> native")


def do_firefox(rec, log):
    # Firefox has no title-bar option; the Mac look is MacTahoe's Firefox
    # theme (what 55-browsers installs). Profiles that appear later (Firefox
    # installed or first opened after Second Wind) get it here. MacTahoe's
    # installer runs `killall firefox`, so only while Firefox is closed.
    theme = os.path.join(STATE, "cache", "MacTahoe-gtk-theme")
    homes = [".mozilla/firefox", "snap/firefox/common/.mozilla/firefox",
             ".var/app/org.mozilla.firefox/.mozilla/firefox"]
    need = [h for h in homes
            if os.path.exists(os.path.join(HOME, h, "profiles.ini"))
            and any(not os.path.exists(os.path.join(d, "chrome"))
                    for d in glob.glob(os.path.join(HOME, h, "*default*")))]
    if not need or not os.path.isdir(theme):
        return
    if running(["firefox", "firefox-bin"]):
        log("firefox: open, will retry at next login")
        return
    r = subprocess.run(["./tweaks.sh", "-f"], cwd=theme, capture_output=True)
    log(f"firefox: MacTahoe theme {'installed' if r.returncode == 0 else 'FAILED'}")


def undo(log):
    rec = load_record()
    left = {}
    for p, before in rec.items():
        try:
            if before == ABSENT + ":file":
                os.remove(p)
                log(f"{p}: removed (we created it)")
            elif before == "__flag__":
                with open(p) as f:
                    txt = f.read()
                with open(p, "w") as f:
                    f.write(txt.replace(" " + X11_FLAG, ""))
                log(f"{p}: {X11_FLAG} removed")
            elif p.endswith("Preferences") or p.endswith("settings.json"):
                with open(p) as f:
                    d = json.load(f)
                if p.endswith("Preferences"):
                    if not isinstance(before, dict):
                        before = {"browser.custom_chrome_frame": before}
                    for k, v in before.items():
                        set_key(d, k, v)
                else:
                    if before == ABSENT:
                        d.pop("window.titleBarStyle", None)
                    else:
                        d["window.titleBarStyle"] = before
                write_json(p, d)
                log(f"{p}: restored")
            else:
                with open(p) as f:
                    lines = [l for l in f.read().splitlines() if not l.startswith("titlebar=")]
                if before != ABSENT and "[General]" in lines:
                    lines.insert(lines.index("[General]") + 1, f"titlebar={before}")
                with open(p, "w") as f:
                    f.write("\n".join(lines) + "\n")
                log(f"{p}: restored")
        except FileNotFoundError:
            pass
        except (OSError, ValueError):
            left[p] = before   # keep it for a later attempt (e.g. app was open)
    save_record(left) if left else (os.path.exists(RECORD) and os.remove(RECORD))


def main():
    quiet = "--quiet" in sys.argv
    log = (lambda m: None) if quiet else (lambda m: print("  " + m))
    if "--undo" in sys.argv:
        undo(log)
        return 0
    rec = load_record()
    for step in (do_chromium, do_chromium_launchers, do_firefox, do_onlyoffice, do_vscode):
        try:
            step(rec, log)
        except Exception as e:   # one app must never block the others
            log(f"{step.__name__}: {e}")
    if rec:
        save_record(rec)
    return 0


if __name__ == "__main__":
    sys.exit(main())
